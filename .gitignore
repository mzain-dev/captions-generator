# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local media storage (generated at runtime)
storage/audio/*
storage/transcripts/*
storage/projects/*
!storage/**/.gitkeep
public/media/videos/*
public/media/renders/*
!public/media/**/.gitkeep

# local test media & configs
*.mp4
transcribe_result.json
.claude/
